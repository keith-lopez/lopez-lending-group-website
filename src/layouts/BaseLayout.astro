---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import BackToTop from "../components/layout/BackToTop.astro";
import StickyMobileCTA from "../components/layout/StickyMobileCTA.astro";
import { CONTACT_EMAIL, CONTACT_PHONE_TEL, NMLS_ID } from "../data/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
}
const { title, description, ogImage = "/images/og-default.jpg", canonical, noindex = false } = Astro.props;
const site = "https://lopezlendingroup.com";
const pageUrl = canonical ?? new URL(Astro.url.pathname, site).toString();
const absOg = new URL(ogImage, site).toString();
const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Lopez Lending Group",
  email: CONTACT_EMAIL,
  telephone: CONTACT_PHONE_TEL,
  areaServed: ["North Carolina", "South Carolina"],
  identifier: {
    "@type": "PropertyValue",
    name: "NMLS ID",
    value: NMLS_ID,
  },
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Lopez Lending Group</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absOg} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Lopez Lending Group" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absOg} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <StickyMobileCTA />
    <BackToTop />
  </body>
</html>
