---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/forms/ContactForm.astro";
---
<BaseLayout title="Contact" description="Reach Lopez Lending Group for quick mortgage questions in NC and SC." ogImage="/images/og-default.jpg">
  <section class="section-y"><div class="container-x"><h1>Have a quick question? Let's talk.</h1></div></section>
  <section class="section-y bg-silver"><div class="container-x grid gap-8 md:grid-cols-2"><ContactForm /><aside class="rounded-card bg-white p-6"><h2 class="text-2xl">Direct contact</h2><p class="mt-3">Mon-Fri 9a-6p</p><p>Serving NC + SC</p><p>NMLS #PLACEHOLDER</p></aside></div></section>
</BaseLayout>
