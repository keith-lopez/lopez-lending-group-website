---
import BaseLayout from "../layouts/BaseLayout.astro";
import EyebrowLabel from "../components/ui/EyebrowLabel.astro";
import ContactForm from "../components/forms/ContactForm.astro";
import {
  CONTACT_EMAIL,
  CONTACT_PHONE_DISPLAY,
  CONTACT_PHONE_TEL,
  CALENDLY_URL,
  nmlsLabel,
} from "../data/site";
---
<BaseLayout
  title="Contact"
  description="Reach Keith Lopez for a quick mortgage question, a referral, or to start a Game Plan in NC or SC."
  ogImage="/images/og-default.jpg"
>
  <section class="section-y">
    <div class="container-x">
      <div class="mx-auto max-w-3xl">
        <EyebrowLabel label="Contact" />
        <h1>Got a quick question? Let's talk.</h1>
        <p class="mt-5 text-lg text-navy/90">
          The fastest way to get a real answer is to send a note or grab 20 minutes on the calendar. I read every message myself and reply within one business day.
        </p>
      </div>
    </div>
  </section>

  <section class="section-y bg-silver">
    <div class="container-x">
      <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-5 lg:gap-12">
        <div class="lg:col-span-3">
          <h2 class="text-2xl md:text-3xl">Send a message</h2>
          <p class="mt-3 text-navy/85">
            Got something specific in mind? Use the form below. Otherwise, the easiest path is to grab a calendar slot directly.
          </p>
          <div class="mt-6">
            <ContactForm />
          </div>
        </div>

        <aside class="lg:col-span-2">
          <div class="rounded-card bg-white p-7 shadow-card">
            <h2 class="text-2xl">Direct contact</h2>
            <dl class="mt-5 space-y-4 text-navy/90">
              <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-teal">Phone</dt>
                <dd class="mt-1">
                  <a
                    class="font-semibold text-navy hover:text-teal focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-2"
                    href={`tel:${CONTACT_PHONE_TEL}`}
                  >
                    {CONTACT_PHONE_DISPLAY}
                  </a>
                </dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-teal">Email</dt>
                <dd class="mt-1">
                  <a
                    class="font-semibold text-navy hover:text-teal focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-2"
                    href={`mailto:${CONTACT_EMAIL}`}
                  >
                    {CONTACT_EMAIL}
                  </a>
                </dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-teal">Schedule directly</dt>
                <dd class="mt-1">
                  <a class="font-semibold text-navy hover:text-teal" href="/schedule">
                    Pick a time on my calendar →
                  </a>
                </dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-teal">Hours</dt>
                <dd class="mt-1">Mon–Fri, 9a–6p ET. Weekends as needed for active files.</dd>
              </div>
            </dl>

            <div class="mt-6 rounded-card bg-silver p-5">
              <h3 class="text-base font-semibold text-navy">Where I lend</h3>
              <p class="mt-2 text-sm text-navy/85">
                Licensed across <strong class="font-semibold">North Carolina</strong> and <strong class="font-semibold">South Carolina</strong>. If you're buying anywhere from Asheville to Charleston to the Outer Banks, we can work together.
              </p>
              <svg
                viewBox="0 0 200 120"
                role="img"
                aria-label="Map outline showing the North Carolina and South Carolina service area"
                class="mt-4 h-auto w-full"
              >
                <rect width="200" height="120" fill="#e4eaeb" rx="8" />
                <path
                  d="M20 50 L70 30 L130 25 L180 40 L180 55 L130 60 L80 65 Z"
                  fill="#366e6d"
                  fill-opacity="0.85"
                />
                <path
                  d="M80 65 L130 60 L165 70 L150 95 L100 95 L70 80 Z"
                  fill="#37465c"
                  fill-opacity="0.9"
                />
                <text x="100" y="48" fill="#fefefe" font-family="Inter, sans-serif" font-size="12" font-weight="600" text-anchor="middle">NC</text>
                <text x="115" y="85" fill="#fefefe" font-family="Inter, sans-serif" font-size="12" font-weight="600" text-anchor="middle">SC</text>
              </svg>
            </div>

            <p class="mt-6 text-xs text-navy/65">{nmlsLabel} · Equal Housing Lender</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section-y bg-navy text-offwhite">
    <div class="container-x text-center">
      <h2 class="text-offwhite">Skip the back-and-forth.</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-offwhite/90">
        Twenty minutes on the calendar is faster than email tag for most questions.
      </p>
      <p class="mt-8">
        <a
          href={CALENDLY_URL}
          class="inline-flex min-h-11 items-center justify-center rounded-btn bg-teal px-6 py-3 text-base font-semibold text-offwhite hover:bg-teal-light focus-visible:outline-2 focus-visible:outline-offwhite focus-visible:outline-offset-2"
        >
          Schedule a Game Plan Call
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
