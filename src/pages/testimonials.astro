---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Testimonials" description="Read sample stories from buyers, homeowners, and referral partners." ogImage="/images/og-default.jpg">
  <section class="section-y"><div class="container-x max-w-prose"><h1>Real conversations, real closings.</h1><p class="mt-4">A calm, organized process builds long-term trust.</p></div></section>
  <section class="section-y bg-silver"><div class="container-x"><div class="grid gap-6 md:grid-cols-3"><article class="rounded-card bg-white p-6">Sample quote #1...</article><article class="rounded-card bg-white p-6">Sample quote #2...</article><article class="rounded-card bg-white p-6">Sample quote #3...</article></div><div class="mt-8 rounded-card border border-dashed border-steel p-8">Reserved for Google/Zillow review widget.</div></div></section>
  <section class="section-y"><div class="container-x"><a href="/schedule" class="rounded-btn bg-teal px-5 py-3 text-offwhite">Schedule a Call</a></div></section>
</BaseLayout>
