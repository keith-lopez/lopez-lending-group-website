---
import BaseLayout from "../layouts/BaseLayout.astro";
import EyebrowLabel from "../components/ui/EyebrowLabel.astro";
import { testimonials } from "../data/testimonials";
---
<BaseLayout
  title="Client Stories"
  description="Sample stories from buyers, homeowners, and agents who've worked with Lopez Lending Group across NC + SC."
  ogImage="/images/og-default.jpg"
>
  <section class="section-y">
    <div class="container-x">
      <div class="mx-auto max-w-3xl">
        <EyebrowLabel label="Client Stories" />
        <h1>The kind of feedback that keeps me going.</h1>
        <p class="mt-5 text-lg text-navy/90">
          A note on what's below: until real client stories are collected and approved for publication, these are sample testimonials clearly marked as such. Verified Google and Zillow reviews will be embedded here as they come in.
        </p>
      </div>
    </div>
  </section>

  <section class="section-y bg-silver">
    <div class="container-x">
      <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-2">
        {testimonials.map((t) => (
          <article class="flex h-full flex-col rounded-card bg-white p-7 shadow-card">
            {t.isSample && (
              <span class="mb-3 inline-flex w-fit items-center rounded-full bg-silver px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-navy/70">
                Sample
              </span>
            )}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 32 32"
              class="mb-4 h-8 w-8 text-teal"
              aria-hidden="true"
            >
              <path fill="currentColor" d="M9.5 8C5.91 8 3 10.91 3 14.5S5.91 21 9.5 21c.69 0 1.36-.11 2-.31C10.69 23.66 8.39 26 5.5 26v3c5.51 0 10-4.49 10-10v-.5c0-.17-.01-.33-.02-.5H15.5C15.5 14.91 12.59 12 9 12V8h.5zm15 0c-3.59 0-6.5 2.91-6.5 6.5S20.91 21 24.5 21c.69 0 1.36-.11 2-.31C25.69 23.66 23.39 26 20.5 26v3c5.51 0 10-4.49 10-10v-.5c0-.17-.01-.33-.02-.5H30.5C30.5 14.91 27.59 12 24 12V8h.5z"/>
            </svg>
            <p class="flex-1 text-lg leading-relaxed text-navy/90">"{t.quote}"</p>
            <div class="mt-6 border-t border-silver-dark pt-4">
              <p class="font-semibold text-navy">{t.name}</p>
              <p class="text-sm text-navy/75">{t.role} · {t.city}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="mx-auto mt-10 max-w-3xl rounded-card border border-dashed border-steel bg-white/60 p-7 text-center">
        <h2 class="text-2xl">Verified review embed</h2>
        <p class="mt-3 text-navy/75">
          Reserved for Google and Zillow review widgets. These will be embedded once review profiles are live.
        </p>
      </div>
    </div>
  </section>

  <section class="section-y bg-navy text-offwhite">
    <div class="container-x text-center">
      <h2 class="text-offwhite">Want to be the next story?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-offwhite/90">
        Start with a 20-minute Game Plan Call. We'll figure out where you stand and what comes next.
      </p>
      <p class="mt-8">
        <a
          href="/schedule"
          class="inline-flex min-h-11 items-center justify-center rounded-btn bg-teal px-6 py-3 text-base font-semibold text-offwhite hover:bg-teal-light focus-visible:outline-2 focus-visible:outline-offwhite focus-visible:outline-offset-2"
        >
          Schedule a Game Plan Call
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
