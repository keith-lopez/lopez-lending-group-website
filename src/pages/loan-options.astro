---
import BaseLayout from "../layouts/BaseLayout.astro";
import EyebrowLabel from "../components/ui/EyebrowLabel.astro";
import { loans } from "../data/loans";
---
<BaseLayout
  title="Loan Options"
  description="Home purchase, conventional, FHA, VA, refinance, and investment property financing options across NC + SC."
  ogImage="/images/og-default.jpg"
>
  <section class="section-y">
    <div class="container-x">
      <div class="mx-auto max-w-3xl">
        <EyebrowLabel label="Loan Options" />
        <h1>Loan programs built around your situation — not the other way around.</h1>
        <p class="mt-5 text-lg text-navy/90">
          With access to 290+ lending partners, I can compare options across conventional, FHA, VA, USDA, jumbo, DSCR, and non-QM programs to find the structure that fits your real life. Below is a quick overview of where most clients land. Don't see your situation? That's exactly what the Game Plan Call is for.
        </p>
      </div>

      <nav aria-label="Loan program quick links" class="mx-auto mt-10 max-w-3xl">
        <ul class="flex flex-wrap justify-center gap-2 text-sm">
          {loans.map((l) => (
            <li>
              <a
                href={`#${l.id}`}
                class="inline-flex items-center rounded-full border border-silver-dark bg-white px-4 py-2 font-medium text-navy hover:border-teal hover:text-teal focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-2"
              >
                {l.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  {loans.map((loan, i) => (
    <section
      id={loan.id}
      class={`section-y scroll-mt-24 ${i % 2 === 0 ? "bg-silver" : ""}`}
    >
      <div class="container-x">
        <div class="mx-auto max-w-3xl">
          <div class="flex items-center gap-4">
            <img
              src={loan.icon}
              alt=""
              width="56"
              height="56"
              loading="lazy"
              class="h-14 w-14 shrink-0"
              aria-hidden="true"
            />
            <h2>{loan.name}</h2>
          </div>
          <p class="mt-5 text-lg text-navy/90">{loan.description}</p>

          <div class="mt-10 grid gap-6 md:grid-cols-3">
            <article class="rounded-card border border-silver-dark bg-white p-6 shadow-card">
              <h3 class="text-lg font-semibold text-navy">Who this is built for</h3>
              <ul class="mt-3 space-y-2 text-sm text-navy/85">
                {loan.builtFor.map((item) => (
                  <li class="flex items-start gap-2">
                    <span class="mt-1 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-teal" aria-hidden="true"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </article>

            <article class="rounded-card border border-silver-dark bg-white p-6 shadow-card">
              <h3 class="text-lg font-semibold text-navy">Why people choose this</h3>
              <ul class="mt-3 space-y-2 text-sm text-navy/85">
                {loan.whyPeopleChoose.map((item) => (
                  <li class="flex items-start gap-2">
                    <span class="mt-1 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-teal" aria-hidden="true"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </article>

            <article class="rounded-card border border-silver-dark bg-white p-6 shadow-card">
              <h3 class="text-lg font-semibold text-navy">What you'll want to have ready</h3>
              <ul class="mt-3 space-y-2 text-sm text-navy/85">
                {loan.whatToHaveReady.map((item) => (
                  <li class="flex items-start gap-2">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="mt-0.5 h-4 w-4 shrink-0 text-teal"
                      aria-hidden="true"
                    >
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </article>
          </div>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:gap-4">
            <a href="/schedule" class="btn-primary">Talk through this option</a>
            <a href="/apply" class="btn-secondary">Or start an application</a>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="section-y bg-navy text-offwhite">
    <div class="container-x text-center">
      <h2 class="text-offwhite">Don't see your situation here?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-offwhite/90">
        That's exactly what the Game Plan Call is for. Self-employed, mixed-income, foreign national, non-QM, bank statement, and asset-depletion programs are all on the menu. Let's talk.
      </p>
      <p class="mt-8">
        <a
          href="/schedule"
          class="inline-flex min-h-11 items-center justify-center rounded-btn bg-teal px-6 py-3 text-base font-semibold text-offwhite hover:bg-teal-light focus-visible:outline-2 focus-visible:outline-offwhite focus-visible:outline-offset-2"
        >
          Schedule a Game Plan Call
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
