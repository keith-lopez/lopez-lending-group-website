---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Loan Options" description="Explore home purchase, conventional, FHA, VA, refinance, and investment options." ogImage="/images/og-default.jpg">
  <section class="section-y"><div class="container-x max-w-prose"><h1>Find the loan that fits your goals — not the other way around.</h1><p class="mt-4">Every path starts with a Mortgage Game Plan.</p></div></section>
  <section class="section-y bg-silver"><div class="container-x space-y-8">
  {['home-purchase','conventional','fha','va','refinance','investment'].map((id)=><article id={id} class="rounded-card bg-white p-6"><h2 class="capitalize">{id.replace('-', ' ')}</h2><p class="mt-2">Overview, best-for bullets, key benefits, and checklist details tailored to your goals.</p><a href="/schedule" class="mt-3 inline-block">Book a call →</a></article>)}
</div></section>
  <section class="section-y"><div class="container-x"><a href="/schedule" class="rounded-btn bg-teal px-5 py-3 text-offwhite">Schedule a Call</a></div></section>
</BaseLayout>
