---
import BaseLayout from "../layouts/BaseLayout.astro";
import EyebrowLabel from "../components/ui/EyebrowLabel.astro";
import { CALENDLY_URL } from "../data/site";

const agenda = [
  "Your goals, your timeline, and any constraints you're aware of",
  "A look at the loan options that actually fit your situation",
  "A clear, written set of next steps you can act on the same day",
];
---
<BaseLayout
  title="Schedule a Game Plan Call"
  description="Book a free, 20-minute Mortgage Game Plan Call with Keith Lopez. No application, no credit pull, no pressure."
  ogImage="/images/og-default.jpg"
>
  <section class="section-y">
    <div class="container-x">
      <div class="mx-auto max-w-3xl">
        <EyebrowLabel label="Schedule a Call" />
        <h1>Let's put your Game Plan together.</h1>
        <p class="mt-5 text-lg text-navy/90">
          A 20-minute conversation about where you are and where you want to be. No application, no credit pull, no pressure. You leave with a plan whether or not we work together.
        </p>
      </div>
    </div>
  </section>

  <section class="section-y bg-silver">
    <div class="container-x">
      <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <h2 class="text-2xl md:text-3xl">What we'll cover</h2>
          <ul class="mt-5 space-y-3">
            {agenda.map((item) => (
              <li class="flex items-start gap-3 text-navy/90">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="mt-1 h-5 w-5 shrink-0 text-teal"
                  aria-hidden="true"
                >
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <div class="mt-8 overflow-hidden rounded-card border border-silver-dark bg-white shadow-card">
            <iframe
              src={CALENDLY_URL}
              title="Schedule a Game Plan Call with Keith Lopez"
              loading="lazy"
              class="h-[720px] w-full"
            ></iframe>
          </div>

          <p class="mt-3 text-xs text-navy/65">
            Calendar not loading? Email
            <a href="mailto:klopez@nexalending.com" class="font-semibold text-teal hover:text-teal-dark">klopez@nexalending.com</a>
            and I'll book you a time directly.
          </p>
        </div>

        <aside class="space-y-6 lg:col-span-1">
          <div class="rounded-card bg-white p-6 shadow-card">
            <span class="inline-flex w-fit items-center rounded-full bg-silver px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-navy/70">
              Sample
            </span>
            <p class="mt-4 text-navy/90">
              "Keith spent 20 minutes on the phone with me before I even thought about applying. He didn't try to sell me anything — he just answered my actual questions. That's why I came back when I was ready."
            </p>
            <p class="mt-4 text-sm font-semibold text-navy">Sample Client</p>
            <p class="text-sm text-navy/75">First-Time Buyer · Raleigh, NC</p>
          </div>

          <div class="rounded-card border-l-4 border-teal bg-white p-6 shadow-card">
            <p class="font-semibold text-navy">No pressure. No commitment.</p>
            <p class="mt-2 text-sm text-navy/85">
              You won't be added to a marketing drip. You won't be hounded. Show up, ask anything, and walk away with a clear next step.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
