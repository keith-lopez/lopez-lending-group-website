---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="About Keith Lopez" description="Learn about Keith Lopez and the values behind Lopez Lending Group in NC and SC." ogImage="/images/og-default.jpg">
  <section class="section-y"><div class="container-x grid items-center gap-8 md:grid-cols-2"><div><h1>Hi, I'm Keith — and I'm the person who actually picks up the phone.</h1><p class="mt-4">I help clients feel informed and supported from pre-approval to closing.</p></div><img src="/images/headshot.jpg" alt="Keith Lopez smiling in a professional headshot" width="640" height="760" loading="eager" class="order-first h-auto w-full max-w-none rounded-card md:order-none" /></div></section>
  <section class="section-y bg-silver"><div class="container-x grid gap-6 md:grid-cols-3"><article><h3>Communication</h3><p>Proactive updates so you always know what is next.</p></article><article><h3>Preparation</h3><p>A clear process to reduce delays and stress.</p></article><article><h3>Transparency</h3><p>Plainspoken guidance and honest expectations.</p></article></div></section>
  <section class="section-y"><div class="container-x"><a href="/schedule" class="rounded-btn bg-teal px-5 py-3 text-offwhite">Schedule a Call</a></div></section>
</BaseLayout>
