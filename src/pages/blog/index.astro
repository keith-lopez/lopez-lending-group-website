---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog")).filter((p)=>!p.data.draft);
---
<BaseLayout title="Blog" description="Mortgage education and planning insights from Lopez Lending Group." ogImage="/images/og-default.jpg">
<section class="section-y"><div class="container-x"><h1>Blog</h1><div class="mt-6 grid gap-6 md:grid-cols-2">{posts.map((post)=><article class="rounded-card border border-silver-dark p-5"><h2 class="text-2xl">{post.data.title}</h2><p class="mt-2">{post.data.description}</p><a class="mt-3 inline-block" href={`/blog/${post.slug}`}>Read post →</a></article>)}</div></div></section>
</BaseLayout>
