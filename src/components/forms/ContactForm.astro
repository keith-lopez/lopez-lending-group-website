---
// TODO: connect to form provider (Formspree, Netlify Forms, or SendGrid)
---
<form
  action="/api/contact"
  method="POST"
  class="space-y-5 rounded-card border border-silver-dark bg-white p-6 shadow-card md:p-8"
>
  <div>
    <label for="cf-name" class="block text-sm font-medium text-navy">
      Name <span class="text-teal" aria-hidden="true">*</span>
    </label>
    <input
      id="cf-name"
      type="text"
      name="name"
      required
      autocomplete="name"
      class="mt-1 w-full rounded-btn border border-steel bg-offwhite p-3 text-navy focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-2"
    />
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div>
      <label for="cf-email" class="block text-sm font-medium text-navy">
        Email <span class="text-teal" aria-hidden="true">*</span>
      </label>
      <input
        id="cf-email"
        type="email"
        name="email"
        required
        autocomplete="email"
        class="mt-1 w-full rounded-btn border border-steel bg-offwhite p-3 text-navy focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-2"
      />
    </div>
    <div>
      <label for="cf-phone" class="block text-sm font-medium text-navy">
        Phone <span class="text-teal" aria-hidden="true">*</span>
      </label>
      <input
        id="cf-phone"
        type="tel"
        name="phone"
        required
        autocomplete="tel"
        inputmode="tel"
        class="mt-1 w-full rounded-btn border border-steel bg-offwhite p-3 text-navy focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-2"
      />
    </div>
  </div>

  <div>
    <label for="cf-best-time" class="block text-sm font-medium text-navy">
      Best time to reach you
    </label>
    <input
      id="cf-best-time"
      type="text"
      name="bestTime"
      placeholder="Weekday mornings, evenings, etc."
      class="mt-1 w-full rounded-btn border border-steel bg-offwhite p-3 text-navy focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-2"
    />
  </div>

  <div>
    <label for="cf-message" class="block text-sm font-medium text-navy">
      Message <span class="text-teal" aria-hidden="true">*</span>
    </label>
    <textarea
      id="cf-message"
      name="message"
      rows="5"
      required
      class="mt-1 w-full rounded-btn border border-steel bg-offwhite p-3 text-navy focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-2"
      placeholder="Tell me what's on your mind."
    ></textarea>
  </div>

  <button type="submit" class="btn-primary w-full sm:w-auto">
    Send Message
  </button>
  <p class="text-xs text-navy/60">
    I read every message myself. Expect a reply within one business day.
  </p>
</form>
