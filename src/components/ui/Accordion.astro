---
import type { FAQ } from "../../data/faqs";
interface Props { items: FAQ[] }
const { items } = Astro.props;
---
<div class="space-y-3">
  {items.map((item) => (
    <details class="rounded-card border border-silver-dark bg-white p-4">
      <summary class="cursor-pointer font-medium focus-visible:outline-2 focus-visible:outline-teal">{item.question}</summary>
      <p class="mt-3 text-sm">{item.answer}</p>
    </details>
  ))}
</div>
