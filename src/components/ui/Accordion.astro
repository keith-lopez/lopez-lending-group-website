---
import type { FAQ } from "../../data/faqs";
interface Props {
  items: FAQ[];
}
const { items } = Astro.props;
---
<div class="space-y-3">
  {items.map((item) => (
    <details class="group rounded-card border border-silver-dark bg-white p-5 shadow-card">
      <summary class="flex cursor-pointer list-none items-start justify-between gap-3 text-base font-semibold text-navy focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-2">
        <span>{item.question}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="h-5 w-5 shrink-0 text-teal transition-transform group-open:rotate-180"
          aria-hidden="true"
        >
          <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd"/>
        </svg>
      </summary>
      <p class="mt-4 text-navy/90">{item.answer}</p>
    </details>
  ))}
</div>
