---
interface Props { href?: string; variant?: "primary"|"secondary"; class?: string; type?: "button"|"submit" }
const { href, variant = "primary", class: className = "", type = "button" } = Astro.props;
const styles = variant === "primary" ? "bg-teal text-offwhite hover:bg-teal-dark" : "border border-steel text-navy hover:bg-silver";
---
{href ? <a href={href} class={`inline-flex min-h-11 items-center justify-center rounded-btn px-5 py-3 font-medium focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-2 ${styles} ${className}`}> <slot/> </a> : <button type={type} class={`inline-flex min-h-11 items-center justify-center rounded-btn px-5 py-3 font-medium focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-2 ${styles} ${className}`}> <slot/> </button>}
