---
interface Props {
  href?: string;
  variant?: "primary" | "secondary";
  class?: string;
  type?: "button" | "submit";
  target?: string;
  rel?: string;
}
const {
  href,
  variant = "primary",
  class: className = "",
  type = "button",
  target,
  rel,
} = Astro.props;
const styles =
  variant === "primary"
    ? "btn-primary"
    : "btn-secondary";
---
{href ? (
  <a href={href} class={`${styles} ${className}`} target={target} rel={rel}>
    <slot />
  </a>
) : (
  <button type={type} class={`${styles} ${className}`}>
    <slot />
  </button>
)}
