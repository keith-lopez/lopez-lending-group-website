---
import { navItems } from "../../data/nav";
---
<details class="relative z-40 md:hidden">
  <summary
    class="inline-flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-btn border border-silver-dark bg-offwhite px-3 text-sm font-semibold text-navy focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-2 [&::-webkit-details-marker]:hidden"
  >
    Menu
  </summary>
  <div class="fixed inset-0 z-40 bg-navy p-8 text-offwhite">
    <ul class="space-y-5 text-lg">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="inline-flex min-h-11 items-center text-xl font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</details>
