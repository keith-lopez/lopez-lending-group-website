---
import { navItems } from "../../data/nav";
---
<div class="md:hidden">
  <button
    type="button"
    id="mobile-nav-trigger"
    aria-controls="mobile-nav-panel"
    aria-expanded="false"
    class="inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-btn border border-silver-dark bg-offwhite px-3 text-sm font-semibold text-navy focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-2"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 20 20"
      fill="currentColor"
      class="h-5 w-5"
      aria-hidden="true"
    >
      <path fill-rule="evenodd" d="M3 5.75A.75.75 0 013.75 5h12.5a.75.75 0 010 1.5H3.75A.75.75 0 013 5.75zm0 4.5A.75.75 0 013.75 9.5h12.5a.75.75 0 010 1.5H3.75A.75.75 0 013 10.25zm.75 3.75a.75.75 0 000 1.5h12.5a.75.75 0 000-1.5H3.75z" clip-rule="evenodd"/>
    </svg>
    <span>Menu</span>
  </button>

  <div
    id="mobile-nav-panel"
    aria-hidden="true"
    aria-label="Mobile navigation"
    class="fixed inset-0 z-50 hidden bg-navy text-offwhite"
  >
    <div class="flex h-full flex-col overflow-y-auto px-6 pb-10 pt-5 sm:px-8">
      <div class="flex items-center justify-between">
        <span class="text-sm font-semibold uppercase tracking-wide text-offwhite/70">
          Menu
        </span>
        <button
          type="button"
          id="mobile-nav-close"
          aria-label="Close navigation"
          class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-btn border border-offwhite/30 px-3 text-sm font-semibold text-offwhite focus-visible:outline-2 focus-visible:outline-offwhite focus-visible:outline-offset-2"
        >
          Close
        </button>
      </div>

      <ul class="mt-10 space-y-1">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              data-mobile-nav-link
              class="flex min-h-12 items-center rounded-btn px-2 text-xl font-medium text-offwhite hover:bg-offwhite/10 focus-visible:outline-2 focus-visible:outline-offwhite focus-visible:outline-offset-2"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-auto space-y-3 pt-10">
        <a
          href="/apply"
          data-mobile-nav-link
          class="block rounded-btn border-2 border-offwhite px-5 py-3 text-center text-base font-semibold text-offwhite hover:bg-offwhite hover:text-navy focus-visible:outline-2 focus-visible:outline-offwhite focus-visible:outline-offset-2"
        >
          Apply Now
        </a>
        <a
          href="/schedule"
          data-mobile-nav-link
          class="block rounded-btn bg-teal px-5 py-3 text-center text-base font-semibold text-offwhite hover:bg-teal-light focus-visible:outline-2 focus-visible:outline-offwhite focus-visible:outline-offset-2"
        >
          Schedule a Call
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const trigger = document.getElementById("mobile-nav-trigger");
    const panel = document.getElementById("mobile-nav-panel");
    const closeBtn = document.getElementById("mobile-nav-close");
    if (!trigger || !panel || !closeBtn) return;

    let lastFocused = null;

    function getFocusable() {
      return Array.from(
        panel.querySelectorAll(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      );
    }

    function open() {
      lastFocused = document.activeElement;
      panel.classList.remove("hidden");
      panel.setAttribute("aria-hidden", "false");
      trigger.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      const focusables = getFocusable();
      if (focusables[0]) focusables[0].focus();
    }

    function close() {
      panel.classList.add("hidden");
      panel.setAttribute("aria-hidden", "true");
      trigger.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      if (lastFocused && typeof lastFocused.focus === "function") {
        lastFocused.focus();
      }
    }

    trigger.addEventListener("click", open);
    closeBtn.addEventListener("click", close);

    panel.querySelectorAll("[data-mobile-nav-link]").forEach((link) => {
      link.addEventListener("click", close);
    });

    document.addEventListener("keydown", function (e) {
      if (panel.classList.contains("hidden")) return;
      if (e.key === "Escape") {
        e.preventDefault();
        close();
        return;
      }
      if (e.key === "Tab") {
        const focusables = getFocusable();
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  })();
</script>
