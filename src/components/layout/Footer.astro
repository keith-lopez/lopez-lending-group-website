---
import {
  CONTACT_EMAIL,
  CONTACT_PHONE_DISPLAY,
  CONTACT_PHONE_TEL,
  brandLogoSrc,
  nmlsLabel,
} from "../../data/site";
---

<footer class="bg-navy text-offwhite">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16 lg:px-8">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      <!-- Brand column (mirrors reference: full-width logo row on sm, 1/3 on lg) -->
      <div class="sm:col-span-2 lg:col-span-1">
        <div class="mb-4">
          <a
            href="/"
            class="block rounded-card bg-offwhite p-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-offwhite"
          >
            <img
              src={brandLogoSrc}
              alt="Lopez Lending Group"
              width="260"
              height="72"
              loading="lazy"
              decoding="async"
              class="h-auto w-full object-contain object-left"
            />
          </a>
        </div>
        <p class="mb-4 text-sm leading-relaxed text-offwhite/85">
          Clear, organized, stress-free mortgage guidance.
        </p>
        <div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-offwhite/75">
          <span>{nmlsLabel}</span>
          <span aria-hidden="true">•</span>
          <span>Equal Housing Lender</span>
        </div>
      </div>

      <div>
        <p class="font-medium">Site Links</p>
        <ul class="mt-2 space-y-3 text-sm">
          <li><a href="/">Home</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/loan-options">Loan Options</a></li>
          <li><a href="/mortgage-roadmap">Mortgage Roadmap</a></li>
          <li><a href="/resources">Resources</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <div>
        <p class="font-medium">Contact</p>
        <p class="mt-2 text-sm">Serving North Carolina + South Carolina</p>
        <p class="text-sm">
          <a class="underline-offset-2 hover:underline" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        </p>
        <p class="text-sm">
          <a class="underline-offset-2 hover:underline" href={`tel:${CONTACT_PHONE_TEL}`}>{CONTACT_PHONE_DISPLAY}</a>
        </p>
      </div>
    </div>
  </div>
  <div class="border-t border-navy-light py-4 text-center text-xs">
    © 2026 Lopez Lending Group · <a href="#">Privacy Policy</a> · <a href="#">Accessibility Statement</a>
  </div>
</footer>
