---
import { navItems } from "../../data/nav";
import {
  CONTACT_EMAIL,
  CONTACT_PHONE_DISPLAY,
  CONTACT_PHONE_TEL,
  NMLS_ID,
  nmlsLabel,
} from "../../data/site";

const currentYear = new Date().getFullYear();
const nmlsConsumerAccessUrl = `https://www.nmlsconsumeraccess.org/EntityDetails.aspx/INDIVIDUAL/${NMLS_ID}`;
---
<footer class="bg-navy text-offwhite">
  <div class="container-x py-14 md:py-16">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-10">
      <div class="sm:col-span-2 lg:col-span-1">
        <a
          href="/"
          class="inline-block rounded-card bg-offwhite/95 p-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-offwhite"
          aria-label="Lopez Lending Group home"
        >
          <img
            src="/images/logo.svg"
            alt="Lopez Lending Group"
            width="240"
            height="64"
            loading="lazy"
            decoding="async"
            class="h-auto w-[200px] object-contain"
          />
        </a>
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-offwhite/85">
          Honest answers, real options, and a closing you can actually plan around. Serving North Carolina and South Carolina.
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-offwhite/75">
          <a
            href={nmlsConsumerAccessUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="underline-offset-2 hover:underline focus-visible:outline-2 focus-visible:outline-offwhite focus-visible:outline-offset-2"
          >
            {nmlsLabel}
          </a>
          <span aria-hidden="true">•</span>
          <span>Equal Housing Lender</span>
        </div>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-offwhite/70">Site</h2>
        <ul class="mt-4 space-y-3 text-sm">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-offwhite hover:text-teal-light focus-visible:outline-2 focus-visible:outline-offwhite focus-visible:outline-offset-2"
              >
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a
              href="/apply"
              class="text-offwhite hover:text-teal-light focus-visible:outline-2 focus-visible:outline-offwhite focus-visible:outline-offset-2"
            >
              Apply
            </a>
          </li>
          <li>
            <a
              href="/schedule"
              class="text-offwhite hover:text-teal-light focus-visible:outline-2 focus-visible:outline-offwhite focus-visible:outline-offset-2"
            >
              Schedule
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-offwhite/70">Contact</h2>
        <ul class="mt-4 space-y-3 text-sm text-offwhite">
          <li>
            <a class="hover:text-teal-light focus-visible:outline-2 focus-visible:outline-offwhite focus-visible:outline-offset-2" href={`tel:${CONTACT_PHONE_TEL}`}>
              {CONTACT_PHONE_DISPLAY}
            </a>
          </li>
          <li>
            <a class="hover:text-teal-light focus-visible:outline-2 focus-visible:outline-offwhite focus-visible:outline-offset-2" href={`mailto:${CONTACT_EMAIL}`}>
              {CONTACT_EMAIL}
            </a>
          </li>
          <li>Serving North Carolina + South Carolina</li>
        </ul>

        <div class="mt-5 flex items-center gap-3" aria-label="Social profiles">
          <a
            href="#"
            aria-label="LinkedIn (link coming soon)"
            class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-offwhite/30 text-offwhite hover:border-teal-light hover:text-teal-light focus-visible:outline-2 focus-visible:outline-offwhite focus-visible:outline-offset-2"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path d="M19 3a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h14zM8.34 17.34V10.5H6.17v6.84h2.17zM7.25 9.5a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5zm10.09 7.84v-3.74c0-1.78-.95-2.6-2.22-2.6a1.91 1.91 0 00-1.74.96V10.5h-2.16v6.84h2.16v-3.66c0-.96.54-1.46 1.25-1.46.71 0 1.16.5 1.16 1.46v3.66h2.16z"/>
            </svg>
          </a>
          <a
            href="#"
            aria-label="Facebook (link coming soon)"
            class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-offwhite/30 text-offwhite hover:border-teal-light hover:text-teal-light focus-visible:outline-2 focus-visible:outline-offwhite focus-visible:outline-offset-2"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path d="M13 22v-8h2.7l.4-3.13H13V8.9c0-.9.25-1.52 1.55-1.52H16.2V4.6c-.29-.04-1.3-.13-2.48-.13-2.45 0-4.13 1.49-4.13 4.24v2.16H7v3.13h2.59V22H13z"/>
            </svg>
          </a>
          <a
            href="#"
            aria-label="Instagram (link coming soon)"
            class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-offwhite/30 text-offwhite hover:border-teal-light hover:text-teal-light focus-visible:outline-2 focus-visible:outline-offwhite focus-visible:outline-offset-2"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
              <path d="M12 7.4a4.6 4.6 0 100 9.2 4.6 4.6 0 000-9.2zm0 7.6a3 3 0 110-6 3 3 0 010 6zm5.85-7.78a1.07 1.07 0 11-2.14 0 1.07 1.07 0 012.14 0zM21 8.4c-.05-1.13-.31-2.13-1.14-2.96A4.04 4.04 0 0016.9 4.3c-1.16-.06-4.65-.06-5.82 0-1.13.05-2.13.31-2.96 1.14A4.04 4.04 0 006.98 8.4c-.06 1.17-.06 4.66 0 5.82.05 1.13.31 2.13 1.14 2.96.83.83 1.83 1.09 2.96 1.14 1.17.06 4.66.06 5.82 0 1.13-.05 2.13-.31 2.96-1.14a4.04 4.04 0 001.14-2.96c.06-1.16.06-4.65 0-5.82z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-offwhite/15">
    <div class="container-x flex flex-col items-start justify-between gap-3 py-5 text-xs text-offwhite/70 sm:flex-row sm:items-center">
      <p>© {currentYear} Lopez Lending Group. All rights reserved.</p>
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <li>
          <a href="#" class="hover:text-offwhite focus-visible:outline-2 focus-visible:outline-offwhite focus-visible:outline-offset-2">
            Privacy Policy
          </a>
        </li>
        <li>
          <a href="#" class="hover:text-offwhite focus-visible:outline-2 focus-visible:outline-offwhite focus-visible:outline-offset-2">
            Accessibility Statement
          </a>
        </li>
        <li>
          <a
            href={nmlsConsumerAccessUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-offwhite focus-visible:outline-2 focus-visible:outline-offwhite focus-visible:outline-offset-2"
          >
            NMLS Consumer Access
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
