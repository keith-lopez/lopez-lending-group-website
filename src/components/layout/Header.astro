---
import Nav from "./Nav.astro";
import MobileNav from "./MobileNav.astro";
import { brandLogoSrc } from "../../data/site";
---
<header class="sticky top-0 z-30 border-b border-silver-dark bg-offwhite/95 backdrop-blur supports-[backdrop-filter]:bg-offwhite/80">
  <div class="container-x flex items-center justify-between gap-3 py-2 md:gap-4 md:py-3">
    <a
      href="/"
      class="inline-flex shrink-0 items-center py-1 focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-2"
      aria-label="Lopez Lending Group home"
    >
      <img
        src={brandLogoSrc}
        alt="Lopez Lending Group"
        width="260"
        height="72"
        loading="eager"
        decoding="async"
        class="h-auto w-[150px] object-contain sm:w-[180px] md:w-[180px] lg:w-[210px]"
      />
    </a>

    <div class="hidden min-w-0 flex-1 justify-center px-2 md:flex lg:px-4">
      <Nav />
    </div>

    <div class="hidden shrink-0 items-center gap-3 md:flex">
      <a
        href="/apply"
        class="text-sm font-semibold text-navy hover:text-teal focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-2 lg:text-base"
      >
        Apply Now
      </a>
      <a
        href="/schedule"
        class="inline-flex min-h-10 items-center justify-center rounded-btn bg-teal px-4 py-2 text-sm font-semibold text-offwhite shadow-sm transition-colors hover:bg-teal-dark focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-2 lg:text-base"
      >
        Schedule a Call
      </a>
    </div>

    <div class="shrink-0 md:hidden">
      <MobileNav />
    </div>
  </div>
</header>
