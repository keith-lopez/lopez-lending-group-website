---
import EyebrowLabel from "../ui/EyebrowLabel.astro";
---
<section class="section-y bg-silver">
  <div class="container-x">
    <div class="mx-auto max-w-3xl text-center">
      <EyebrowLabel label="Already Shopping?" align="center" />
      <h2>Send me your Loan Estimate. I'll review it for free.</h2>
      <p class="mt-5 text-lg text-navy/90">
        Already received a Loan Estimate from another lender? Send it over. I'll review your rate, fees, and structure side-by-side with what I'd offer — and I'll tell you straight whether you should stay where you are or come over. Even if you don't end up working with me, you'll walk away knowing exactly what you're paying for.
      </p>
      <div class="mt-8">
        <a href="/second-look" class="btn-primary">
          Get a free second look
          <span class="ml-2 inline-block" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
