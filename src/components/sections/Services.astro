---
import { loans } from "../../data/loans";
---
<section class="section-y"><div class="container-x"><h2>Loan options that fit where you actually are</h2><div class="mt-10 grid gap-6 md:grid-cols-3">{loans.map((loan)=><article class="rounded-card border border-silver-dark bg-white p-6 shadow-card"><img src={loan.icon} alt={`${loan.name} icon`} width="40" height="40" loading="lazy"/><h3 class="mt-3 text-lg">{loan.name}</h3><p class="mt-2 text-sm">{loan.description}</p><a class="mt-3 inline-block" href={`/loan-options#${loan.id}`}>Learn more →</a></article>)}</div></div></section>
