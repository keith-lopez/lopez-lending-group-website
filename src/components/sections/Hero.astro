---
import EyebrowLabel from "../ui/EyebrowLabel.astro";

const bullets = [
  "Access to 290+ Lending Partners",
  "A Personal Game Plan, Not a Sales Pitch",
  "Lending Across NC + SC",
];
---
<section class="pb-16 pt-8 md:pb-24 md:pt-12">
  <div class="container-x grid items-center gap-10 md:grid-cols-2 md:gap-12 lg:gap-16">
    <div class="min-w-0">
      <EyebrowLabel label="Keith Lopez | Lopez Lending Group" />
      <h1 class="mt-2">
        Honest answers, real options, and a closing you can actually plan around.
      </h1>
      <p class="mt-5 text-lg leading-snug text-navy/90 md:text-xl">
        Mortgage loan officer serving homebuyers, homeowners, and real estate partners across North Carolina and South Carolina.
      </p>
      <p class="mt-5 text-navy/85">
        I'm Keith Lopez. With access to 290+ lenders, I help you see the options most loan officers won't show you — and then build a plan around your real life, not a one-size-fits-all script.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
        <a href="/schedule" class="btn-primary">
          Schedule a Game Plan Call
        </a>
        <a
          href="/loan-options"
          class="group btn-secondary"
        >
          See Loan Options
          <span class="ml-1 inline-block transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      </div>

      <ul
        class="mt-10 grid gap-4 border-t border-silver-dark pt-8 sm:grid-cols-3"
        aria-label="How Lopez Lending Group serves borrowers"
      >
        {bullets.map((b) => (
          <li class="flex items-start gap-2 text-sm font-semibold leading-snug text-navy md:text-base">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="mt-0.5 h-5 w-5 shrink-0 text-teal"
              aria-hidden="true"
              focusable="false"
            >
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"
              />
            </svg>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="order-first flex justify-center md:order-none md:justify-end">
      <img
        src="/images/headshot.jpg"
        alt="Keith Lopez, mortgage loan officer with Lopez Lending Group"
        width="480"
        height="600"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-auto w-full max-w-[280px] rounded-card object-cover shadow-card sm:max-w-[340px] md:max-w-[380px] lg:max-w-[420px]"
      />
    </div>
  </div>
</section>
