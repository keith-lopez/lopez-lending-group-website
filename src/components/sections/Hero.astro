<section class="pb-20 pt-6 md:pb-28 md:pt-10">
  <div class="container-x grid items-center gap-8 md:grid-cols-2 md:gap-10 lg:gap-12 lg:[grid-template-columns:minmax(0,1fr)_minmax(0,26rem)]">
    <div class="min-w-0">
      <p class="text-sm font-semibold tracking-wide text-teal md:text-base">
        Keith Lopez&nbsp;&nbsp;|&nbsp;&nbsp;Lopez Lending Group
      </p>
      <h1 class="mt-3">
        Find the Right Loan. Keep the Process Clear. Feel Confident Through Closing.
      </h1>
      <div class="mt-4 max-lg:-mx-1 max-lg:overflow-x-auto max-lg:px-1 lg:mx-0 lg:overflow-visible [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">
        <p class="inline-block min-w-max text-base font-medium leading-snug text-navy whitespace-nowrap md:text-lg lg:text-xl">
          Mortgage Loan Officer in Summerville, SC — lending in NC and SC.
        </p>
      </div>
      <p class="mt-5 text-navy/90">
        I'm Keith Lopez, a mortgage loan officer with access to 290+ lenders. That matters because no two buyers walk in with the same finances, timeline, or goals — and a one-lender shop will quietly make you fit their box. I'll show you the options that actually fit your life and the plan to get there.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
        <a
          href="/schedule"
          class="inline-flex min-h-11 items-center justify-center rounded-btn bg-teal px-6 py-3 text-center text-base font-semibold text-offwhite shadow-sm transition-all duration-200 hover:bg-teal-dark hover:shadow-md active:translate-y-px focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-2"
        >
          Schedule a Mortgage Game Plan Call
        </a>
        <a
          href="/apply"
          class="group inline-flex min-h-11 items-center justify-center rounded-btn border-2 border-teal bg-offwhite px-6 py-3 text-center text-base font-semibold text-navy transition-all duration-200 hover:border-teal-dark hover:bg-silver hover:text-navy active:translate-y-px focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-2"
        >
          Or start your application
          <span class="ml-1 inline-block transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      </div>

      <ul
        class="mt-8 flex flex-row flex-nowrap gap-8 overflow-x-auto overscroll-x-contain border-t border-silver-dark pt-8 pb-1 [-ms-overflow-style:none] [scrollbar-width:none] md:gap-10 xl:grid xl:grid-cols-3 xl:gap-x-10 xl:gap-y-0 xl:overflow-visible xl:pb-0 [&::-webkit-scrollbar]:hidden"
        aria-label="How Lopez Lending Group serves borrowers"
      >
        <li
          class="flex shrink-0 items-start gap-2 text-sm font-semibold leading-normal text-navy xl:min-w-0 xl:items-center xl:justify-center xl:text-base"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="mt-0.5 block h-5 w-5 shrink-0 text-teal xl:mt-0"
            aria-hidden="true"
            focusable="false"
          >
            <path
              fill-rule="evenodd"
              d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="whitespace-nowrap">Access to 290+ Lenders</span>
        </li>
        <li
          class="flex shrink-0 items-start gap-2 text-sm font-semibold leading-normal text-navy xl:min-w-0 xl:items-center xl:justify-center xl:text-base"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="mt-0.5 block h-5 w-5 shrink-0 text-teal xl:mt-0"
            aria-hidden="true"
            focusable="false"
          >
            <path
              fill-rule="evenodd"
              d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="whitespace-nowrap">Personalized Loan Strategy</span>
        </li>
        <li
          class="flex shrink-0 items-start gap-2 text-sm font-semibold leading-normal text-navy xl:min-w-0 xl:items-center xl:justify-center xl:text-base"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="mt-0.5 block h-5 w-5 shrink-0 text-teal xl:mt-0"
            aria-hidden="true"
            focusable="false"
          >
            <path
              fill-rule="evenodd"
              d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="whitespace-nowrap">Lending in NC and SC</span>
        </li>
      </ul>
    </div>
    <div class="order-first flex justify-center md:order-none md:justify-end">
      <img
        src="/images/headshot.jpg"
        alt="Keith Lopez standing in a professional portrait"
        width="480"
        height="600"
        loading="eager"
        class="h-auto w-full max-w-[260px] rounded-card object-cover shadow-card sm:max-w-[300px] md:max-w-[340px] lg:max-w-[380px]"
      />
    </div>
  </div>
</section>
